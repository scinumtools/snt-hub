---
import hubVersion from '../../../VERSION?raw';

const base = import.meta.env.BASE_URL;
const home = base.endsWith('/') ? base : base + '/';
const version = hubVersion.trim();
---
<footer class="site-footer shell">
  <a class="logo" href={home} aria-label="SNT Hub home">
    <img src={home + 'snt-hub-logo.svg'} alt="{?SNT.HUB}" width="174" height="34" />
  </a>
  <span>One parameter layer. Many scientific codes.</span>
  <div>
    <a href={home + 'registry/'}>Registry ↗</a>
    <a href="https://github.com/scinumtools/snt3">SNT3 source ↗</a>
    <a href="https://scinumtools.github.io/snt3/initiative.html">Initiative ↗</a>
    <a href={home + 'integration-levels/'}>Levels &amp; statuses ↗</a>
    <a href="https://scinumtools.github.io/snt3/dipl/index.html">DIPL ↗</a>
    <a href="https://github.com/scinumtools/snt-hub">Hub source ↗</a>
    <small class="footer-version" aria-label={`SNT Hub version ${version}`}>v{version}</small>
  </div>
</footer>
