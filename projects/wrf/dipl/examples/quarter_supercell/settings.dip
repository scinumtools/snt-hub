# Pinned reference: WRF v4.8.0 test/em_quarter_ss/namelist.input.

time_control : wrf_time_control
  run_days = 0 day
  run_hours = 0 h
  run_minutes = 60 min
  history_interval = 30 min

domains : wrf_domains
  time_step = 12 s
  e_we = 42
  e_sn = 42
  e_vert = 41
  dx = 2000.0 m
  dy = 2000.0 m
  ztop = 20000.0 m

dynamics : wrf_dynamics
  hybrid_opt = 0
  damp_opt = 2
  zdamp = 5000.0 m
  dampcoef = 0.003 1/s
  khdif = 500.0 m2/s
  kvdif = 500.0 m2/s

bdy_control : wrf_boundary
  periodic_x = false
  open_xs = true
  open_xe = true

ideal : wrf_ideal
  ideal_case = 2
