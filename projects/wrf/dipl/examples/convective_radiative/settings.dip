# Pinned reference: WRF v4.8.0 test/em_convrad/namelist.input.

time_control : wrf_time_control
  run_days = 0
  run_hours = 1
  run_minutes = 0
  history_interval = 60

domains : wrf_domains
  time_step = 5
  e_we = 101
  e_sn = 101
  e_vert = 35
  dx = 1000.0
  dy = 1000.0
  ztop = 30000.0

dynamics : wrf_dynamics
  hybrid_opt = 0
  damp_opt = 3
  zdamp = 5000.0
  dampcoef = 0.2
  khdif = 0.0
  kvdif = 0.0

bdy_control : wrf_boundary
  periodic_x = true
  open_xs = false
  open_xe = false

ideal : wrf_ideal
  ideal_case = 3
