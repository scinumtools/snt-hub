# Pinned reference: WRF v4.8.0 test/em_convrad/namelist.input.

time_control : wrf_time_control
  run_days = 0 day
  run_hours = 1 h
  run_minutes = 0 min
  history_interval = 60 min

domains : wrf_domains
  time_step = 5 s
  e_we = 101
  e_sn = 101
  e_vert = 35
  dx = 1000.0 m
  dy = 1000.0 m
  ztop = 30000.0 m

dynamics : wrf_dynamics
  hybrid_opt = 0
  damp_opt = 3
  zdamp = 5000.0 m
  dampcoef = 0.2 1/s
  khdif = 0.0 m2/s
  kvdif = 0.0 m2/s

bdy_control : wrf_boundary
  periodic_x = true
  open_xs = false
  open_xe = false

ideal : wrf_ideal
  ideal_case = 3
