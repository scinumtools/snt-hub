# Pinned reference: WRF v4.8.0 test/em_grav2d_x/namelist.input.
time_control : wrf_time_control
  run_days = 0 day
  run_hours = 0 h
  run_minutes = 15 min
  history_interval = 1 min

domains : wrf_domains
  time_step = 1 s
  e_we = 513
  e_sn = 3
  e_vert = 65
  dx = 100.0 m
  dy = 100.0 m
  ztop = 6409.0 m

dynamics : wrf_dynamics
  hybrid_opt = 0
  damp_opt = 0
  zdamp = 15000.0 m
  dampcoef = 0.025 1/s
  khdif = 75.0 m2/s
  kvdif = 75.0 m2/s

bdy_control : wrf_boundary
  periodic_x = true
  open_xs = false
  open_xe = false

ideal : wrf_ideal
  ideal_case = 6
