# Pinned reference: WRF v4.8.0 test/em_squall2d_x/namelist.input.

time_control : wrf_time_control
  run_days = 0 day
  run_hours = 1 h
  run_minutes = 0 min
  history_interval = 10 min

domains : wrf_domains
  time_step = 3 s
  e_we = 202
  e_sn = 3
  e_vert = 81
  dx = 250.0 m
  dy = 250.0 m
  ztop = 20000.0 m

dynamics : wrf_dynamics
  hybrid_opt = 0
  damp_opt = 2
  zdamp = 5000.0 m
  dampcoef = 0.003 1/s
  khdif = 300.0 m2/s
  kvdif = 1.0 m2/s

bdy_control : wrf_boundary
  periodic_x = false
  open_xs = true
  open_xe = true

ideal : wrf_ideal
  ideal_case = 4
