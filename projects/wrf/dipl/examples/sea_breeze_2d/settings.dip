# Pinned reference: WRF v4.8.0 test/em_seabreeze2d_x/namelist.input.

time_control : wrf_time_control
  run_days = 0 day
  run_hours = 12 h
  run_minutes = 0 min
  history_interval = 30 min

domains : wrf_domains
  time_step = 15 s
  e_we = 202
  e_sn = 3
  e_vert = 35
  dx = 2000.0 m
  dy = 2000.0 m
  ztop = 20000.0 m

dynamics : wrf_dynamics
  hybrid_opt = 0
  damp_opt = 2
  zdamp = 5000.0 m
  dampcoef = 0.003 1/s
  khdif = 300.0 m2/s
  kvdif = 1.0 m2/s

bdy_control : wrf_boundary
  periodic_x = true
  open_xs = false
  open_xe = false
