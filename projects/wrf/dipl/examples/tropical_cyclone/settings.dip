# Pinned reference: WRF v4.8.0 test/em_tropical_cyclone/namelist.input.

time_control : wrf_time_control
  run_days = 6 day
  run_hours = 0 h
  run_minutes = 0 min
  history_interval = 1440 min

domains : wrf_domains
  time_step = 60 s
  e_we = 201
  e_sn = 201
  e_vert = 21
  dx = 15000.0 m
  dy = 15000.0 m
  ztop = 25000.0 m

dynamics : wrf_dynamics
  hybrid_opt = 0
  damp_opt = 2
  zdamp = 5000.0 m
  dampcoef = 0.003 1/s
  khdif = 300.0 m2/s
  kvdif = 1.0 m2/s

bdy_control : wrf_boundary
  periodic_x = true
  open_xs = false
  open_xe = false
