# Pinned reference: WRF v4.8.0 test/em_tropical_cyclone/namelist.input.

time_control : wrf_time_control
  run_days = 6
  run_hours = 0
  run_minutes = 0
  history_interval = 1440

domains : wrf_domains
  time_step = 60
  e_we = 201
  e_sn = 201
  e_vert = 21
  dx = 15000.0
  dy = 15000.0
  ztop = 25000.0

dynamics : wrf_dynamics
  hybrid_opt = 0
  damp_opt = 2
  zdamp = 5000.0
  dampcoef = 0.003
  khdif = 300.0
  kvdif = 1.0

bdy_control : wrf_boundary
  periodic_x = true
  open_xs = false
  open_xe = false
