$schema subfind_analysis_settings
  ?descr "Subfind runtime controls."
  ?url "https://arepo-code.org/wp-content/userguide/parameterfile.html#subfind-parameters"

  linking_neighbors int
    !condition ({.} > 0)
    ?descr "Minimum number of particles/cells retained in a Subfind group."
    ?native "DesLinkNgb"
    !tags ["arepo:param"]
    ?requires "build.analysis.subfind"

  opening_angle float
    !condition ({.} > 0)
    ?descr "Subfind tree opening angle."
    ?native "ErrTolThetaSubfind"
    !tags ["arepo:param"]
    ?requires "build.analysis.subfind"

$schema analysis_settings
  ?descr "Runtime analysis settings."
  ?url "https://arepo-code.org/wp-content/userguide/parameterfile.html#subfind-parameters"

  subfind : subfind_analysis_settings
