# Typed imports of upstream scientific datasets. Numeric conventions are preserved.
datasets.Masses_z0_5
  output_file str = "Masses_z0.5.txt"
    !tags ["arepo:dataset"]
    ?see "examples/cosmo_zoom_gravity_only_3d/Masses_z0.5.txt"
  data table = {dataset_Masses_z0_5}

