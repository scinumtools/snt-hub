# Semantic counterpart of examples/galaxy_merger_star_formation_3d.
experiment : experiment_settings
  setup
    kind = "galaxy_merger_star_formation_3d"
build : arepo_build
  physics
    cooling = true
    star_formation = true
    jeans_cell_stability = true
  gravity
    self_gravity = true
    hierarchical = true
    cell_center_evaluation = true
    direct_summation = true
      threshold = 500
    non_periodic = true
    multiple_node_softening = true
    individual_softening_type_mask = 32
    softening_types = 2
      export
        enabled = true
  time
    tree_based_timesteps = true
  precision
    mode = 1
    neighbor_tree_double = true
  io
    hdf5 = true
  mesh
    refinement = true
    adaptive_hydro_softening = true
    center_of_mass_drift = true
    drift_limited_by_sound_speed = true
    face_angle_regularization = true
    volume_refinement = true
    no_refine_background_grid = true
    override_peanogrid_warning = true
  output
    process_schedule_exactly = true
  diagnostics
    debug = true
input
  initial_conditions
    path = "./ICs_1_1_merger_30_15_45_0_rmin10_start320_lowres.dat-with-grid"
resources
  wall_clock
    limit = 93000 s
    restart_interval = 12000 s
output
  schedule
    enabled = true
    filename = "./output_list.txt"
  snapshots
    directory = "./output"
simulation
  domain
    boundary = "non_periodic"
    box
      size = 649.201 arepo_length
  time
    end = 3
    maximum_step = 0.0234375
    minimum_step = 2e-8
    statistics_interval = 0.0234375
    snapshot_interval = 0
cosmology
  hubble_parameter = 0.6774
hydrodynamics
  initial_gas_temperature = 244.8095 K
  minimum_gas_temperature = 5 K
  minimum_startup_density = 1e-10 arepo_density
  maximum_neighbor_deviation = 4
gravity
  force_accuracy
    integration = 0.012
    opening_angle = 0.7
    relative_force = 0.0025
  domain_decomposition
    multiple_domains = 8
    top_node_factor = 2.5
  hydro
    gas_softening_factor = 2.5
    minimum_comoving = 1 arepo_length
    spacing = 1.2
  softenings
    comoving[0]
      length = 2 arepo_length
    comoving[1]
      length = 2 arepo_length
    physical_maximum[0]
      length = 2 arepo_length
    physical_maximum[1]
      length = 2 arepo_length
    particle_type_map = [0,1,1,1,1,1]
mesh
  refinement
    reference_gas_mass = 9.76211e-5 arepo_mass
    mean_volume float = 66800.2 arepo_length3
      ?native "MeanVolume"
      !tags ["arepo:param"]
    maximum_volume_difference float = 10
      ?native "MaxVolumeDiff"
      !tags ["arepo:param"]
    minimum_volume float = 1 arepo_length3
      ?native "MinVolume"
      !tags ["arepo:param"]
    maximum_volume float = 1e9 arepo_length3
      ?native "MaxVolume"
      !tags ["arepo:param"]
cooling : cooling_settings
  uv_background_file = "./TREECOOL_ep"

star_formation : star_formation_settings
  critical_overdensity = 57.7
  temperature_threshold = 1e6 K
  critical_physical_density = 0 kg/m3
  supernova_temperature = 5.73e7 K
  cloud_temperature = 1000 K
  maximum_timescale = 2.27 arepo_time
  supernova_factor = 0.1
  evaporation_factor = 573

# Output schedule from the upstream example create.py (%g precision).
output_schedule table = {schedule_data}
