# Semantic counterpart of examples/current_sheet_2d.
experiment : experiment_settings
  setup
    kind = "current_sheet_2d"
build : arepo_build
  geometry
    two_dimensional = true
  physics
    magnetohydrodynamics = true
      powell_cleaning = true
      powell_limit_timestep = true
  numerics
    riemann_hlld = true
  mesh
    center_of_mass_drift = true
    drift_limited_by_sound_speed = true
    face_angle_regularization = true
  time
    tree_based_timesteps = true
  precision
    mode = 1
  io
    input_double_precision = true
    hdf5 = true
  output
    magnetic_field_gradient = true
  diagnostics
    debug = true
simulation
  domain
    box
      size = 2 arepo_length
  time
    end = 4
    maximum_step = 0.2
    minimum_step = 1e-5
    snapshot_interval = 0.5
    timestep_criterion = 1
gravity
  domain_decomposition
    active_fraction = 0.5
