# Shared semantic input model for the two pinned, self-contained LJ examples.
$schema lj_geometry
  ?descr "Simulation dimensionality and atom generation from a lattice."
  ?url "https://docs.lammps.org/lattice.html"
  dimension int = 3
    !options [2, 3]
    ?descr "Spatial dimension; the melt uses the 3D default and the minimization example uses 2D."
    !tags ["lammps:param"]
    ?native "dimension"
  lattice_style str
    !options ["fcc", "sq2"]
    ?descr "Lattice geometry used to create the initial atoms."
    !tags ["lammps:param"]
    ?native "lattice"
  lattice_density float
    !condition ({.} > 0)
    ?descr "Reduced number density passed to the lattice command."
    !tags ["lammps:param"]
    ?native "lattice"
  xlo float = 0
    ?descr "Lower x coordinate of the simulation box in lattice units."
    !tags ["lammps:param"]
    ?native "region box"
  xhi float
    ?descr "Upper x coordinate of the simulation box in lattice units."
    !tags ["lammps:param"]
    ?native "region box"
  ylo float = 0
    ?descr "Lower y coordinate of the simulation box in lattice units."
    !tags ["lammps:param"]
    ?native "region box"
  yhi float
    ?descr "Upper y coordinate of the simulation box in lattice units."
    !tags ["lammps:param"]
    ?native "region box"
  zlo float
    ?descr "Lower z coordinate; 2D LAMMPS still needs a finite z extent."
    !tags ["lammps:param"]
    ?native "region box"
  zhi float
    ?descr "Upper z coordinate; 2D LAMMPS still needs a finite z extent."
    !tags ["lammps:param"]
    ?native "region box"
  atom_mass float = 1
    !condition ({.} > 0)
    ?descr "Mass of the sole atom type in reduced LJ units."
    !tags ["lammps:param"]
    ?native "mass"

$schema lj_interactions
  ?descr "Lennard-Jones pair potential and neighbor-list controls."
  ?url "https://docs.lammps.org/pair_lj.html"
  epsilon float = 1
    !condition ({.} > 0)
    ?descr "LJ energy scale epsilon in reduced units."
    !tags ["lammps:param"]
    ?native "pair_coeff"
  sigma float = 1
    !condition ({.} > 0)
    ?descr "LJ length scale sigma in reduced units."
    !tags ["lammps:param"]
    ?native "pair_coeff"
  cutoff float = 2.5
    !condition ({.} > 0)
    ?descr "Distance cutoff for the LJ pair style and pair coefficient."
    !tags ["lammps:param"]
    ?native "pair_style lj/cut"
  shift_potential bool = false
    ?descr "Shift the pair potential to zero at the cutoff."
    !tags ["lammps:param"]
    ?native "pair_modify shift"
  neighbor_skin float = 0.3
    !condition ({.} > 0)
    ?descr "Extra neighbor-list skin distance in LJ length units."
    !tags ["lammps:param"]
    ?native "neighbor"
  neighbor_every int
    !condition ({.} > 0)
    ?descr "Neighbor-list rebuild check interval in timesteps."
    !tags ["lammps:param"]
    ?native "neigh_modify every"
  neighbor_delay int = 0
    !condition ({.} >= 0)
    ?descr "Minimum delay before a neighbor-list rebuild."
    !tags ["lammps:param"]
    ?native "neigh_modify delay"
  neighbor_check bool
    ?descr "Whether to check atom motion before rebuilding the neighbor list."
    !tags ["lammps:param"]
    ?native "neigh_modify check"

$schema lj_dynamics
  ?descr "Initial velocity, integration, and run controls."
  ?url "https://docs.lammps.org/run.html"
  initial_temperature float
    !condition ({.} >= 0)
    ?descr "Initial temperature used to draw atom velocities in LJ units."
    !tags ["lammps:param"]
    ?native "velocity create"
  velocity_seed int
    !condition ({.} > 0)
    ?descr "Random seed for reproducible initial velocities."
    !tags ["lammps:param"]
    ?native "velocity create"
  enforce_2d bool = false
    ?descr "Constrain force and velocity components outside the 2D plane."
    !tags ["lammps:param"]
    ?native "fix enforce2d"
  thermo_interval int
    !condition ({.} > 0)
    ?descr "Thermodynamic output interval during the dynamics run."
    !tags ["lammps:param"]
    ?native "thermo"
  run_steps int
    !condition ({.} >= 0)
    ?descr "Number of integration timesteps before any minimization phase."
    !tags ["lammps:param"]
    ?native "run"

$schema lj_minimization
  ?descr "Optional post-run energy minimization in the pinned 2D example."
  ?url "https://docs.lammps.org/minimize.html"
  thermo_interval_after_run int
    !condition ({.} > 0)
    ?descr "Thermodynamic output interval during minimization."
    !tags ["lammps:param"]
    ?native "thermo"
  energy_tolerance float
    !condition ({.} >= 0)
    ?descr "Energy convergence tolerance for minimization."
    !tags ["lammps:param"]
    ?native "minimize"
  force_tolerance float
    !condition ({.} >= 0)
    ?descr "Force convergence tolerance for minimization."
    !tags ["lammps:param"]
    ?native "minimize"
  max_iterations int
    !condition ({.} > 0)
    ?descr "Maximum optimizer iterations."
    !tags ["lammps:param"]
    ?native "minimize"
  max_evaluations int
    !condition ({.} > 0)
    ?descr "Maximum force/energy evaluations."
    !tags ["lammps:param"]
    ?native "minimize"

$schema flow_geometry
  ?descr "Two-dimensional channel geometry and fixed wall groups for driven Lennard-Jones flow."
  ?url "https://docs.lammps.org/region.html"
  lattice_density float = 0.7
    !condition ({.} > 0)
    ?descr "Hexagonal lattice density used to create the channel atoms."
    !tags ["lammps:param"]
    ?native "lattice"
  xlo float = 0
    ?descr "Lower x bound of the 2D channel."
    !tags ["lammps:param"]
    ?native "region box"
  xhi float = 20
    ?descr "Upper x bound of the 2D channel."
    !tags ["lammps:param"]
    ?native "region box"
  ylo float = 0
    ?descr "Lower y bound of the channel."
    !tags ["lammps:param"]
    ?native "region box"
  yhi float = 10
    ?descr "Upper y bound of the channel."
    !tags ["lammps:param"]
    ?native "region box"
  zlo float = -0.25
    ?descr "Lower z bound of the thin 2D simulation box."
    !tags ["lammps:param"]
    ?native "region box"
  zhi float = 0.25
    ?descr "Upper z bound of the thin 2D simulation box."
    !tags ["lammps:param"]
    ?native "region box"
  lower_wall_top float = 1.25
    ?descr "Upper y boundary of the lower fixed wall group."
    !tags ["lammps:param"]
    ?native "region lower"
  upper_wall_bottom float = 8.75
    ?descr "Lower y boundary of the upper fixed wall group."
    !tags ["lammps:param"]
    ?native "region upper"
  atom_mass float = 1
    !condition ({.} > 0)
    ?descr "Mass assigned to each of the three atom types in reduced LJ units."
    !tags ["lammps:param"]
    ?native "mass"

$schema flow_interactions
  ?descr "Lennard-Jones interaction and neighbor-list controls for the flow channel."
  ?url "https://docs.lammps.org/pair_lj.html"
  cutoff float = 1.12246
    !condition ({.} > 0)
    ?descr "Lennard-Jones cutoff used for pair_style and pair_coeff."
    !tags ["lammps:param"]
    ?native "pair_style lj/cut"
  neighbor_skin float = 0.3
    !condition ({.} > 0)
    ?descr "Neighbor-list skin distance."
    !tags ["lammps:param"]
    ?native "neighbor"
  neighbor_delay int = 5
    !condition ({.} >= 0)
    ?descr "Minimum delay before checking for a neighbor-list rebuild."
    !tags ["lammps:param"]
    ?native "neigh_modify delay"

$schema flow_thermostat
  ?descr "Initial velocities, temperature rescaling, and integration controls."
  ?url "https://docs.lammps.org/fix_temp_rescale.html"
  initial_temperature float = 1
    !condition ({.} >= 0)
    ?descr "Initial temperature for mobile flow atoms."
    !tags ["lammps:param"]
    ?native "velocity create"
  velocity_seed int = 482748
    !condition ({.} > 0)
    ?descr "Seed for the initial mobile-atom velocity distribution."
    !tags ["lammps:param"]
    ?native "velocity create"
  rescale_every int = 200
    !condition ({.} > 0)
    ?descr "Temperature-rescale interval in timesteps."
    !tags ["lammps:param"]
    ?native "fix temp/rescale"
  rescale_window float = 0.02
    !condition ({.} >= 0)
    ?descr "Temperature-rescale window in reduced temperature units."
    !tags ["lammps:param"]
    ?native "fix temp/rescale"
  timestep float = 0.003
    !condition ({.} > 0)
    ?descr "Integration timestep in reduced LJ units."
    !tags ["lammps:param"]
    ?native "timestep"
  thermo_interval int = 500
    !condition ({.} > 0)
    ?descr "Thermodynamic output interval."
    !tags ["lammps:param"]
    ?native "thermo"
  run_steps int = 10000
    !condition ({.} >= 0)
    ?descr "Number of timesteps for the driven-flow run."
    !tags ["lammps:param"]
    ?native "run"

$schema couette_drive
  ?descr "Boundary velocity for planar Couette flow."
  ?url "https://docs.lammps.org/velocity.html"
  upper_wall_speed float = 3
    ?descr "Tangential velocity assigned to the upper wall atoms."
    !tags ["lammps:param"]
    ?native "velocity upper set"

$schema poiseuille_drive
  ?descr "Wall constraints and body force for planar Poiseuille flow."
  ?url "https://docs.lammps.org/fix_addforce.html"
  upper_wall_force float = -1
    ?descr "Normal force applied to upper wall atoms by aveforce."
    !tags ["lammps:param"]
    ?native "fix upper aveforce"
  flow_acceleration float = 0.5
    ?descr "Streamwise force per mobile atom."
    !tags ["lammps:param"]
    ?native "fix flow addforce"
