# Pinned reference: examples/min/in.min at stable_30Sep2026.
geometry : lj_geometry
  dimension = 2
  lattice_style = "sq2"
  lattice_density = 0.8442
  xlo = 0
  xhi = 20
  ylo = 0
  yhi = 20
  zlo = -0.1
  zhi = 0.1
  atom_mass = 1.0

interactions : lj_interactions
  epsilon = 1.0
  sigma = 1.0
  cutoff = 2.5
  shift_potential = true
  neighbor_skin = 0.3
  neighbor_every = 1
  neighbor_delay = 0
  neighbor_check = true

dynamics : lj_dynamics
  initial_temperature = 5.0
  velocity_seed = 87287
  enforce_2d = true
  thermo_interval = 100
  run_steps = 1000

minimization : lj_minimization
  thermo_interval_after_run = 50
  energy_tolerance = 1.0e-6
  force_tolerance = 0.001
  max_iterations = 1000
  max_evaluations = 10000
