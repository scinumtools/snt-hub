$schema castro_mesh_1d
  ?descr "One-dimensional base grid and adaptive mesh refinement controls."
  nx int
    !condition ({.} > 0)
    ?descr "Base grid cells along the sole spatial coordinate."
    ?native "amr.n_cell"
  max_level int
    !condition ({.} >= 0)
    ?descr "Maximum AMR level; refinement indicators remain as in the pinned source."
    ?native "amr.max_level"
  regrid_interval int
    !condition ({.} > 0)
    ?descr "Timesteps between regridding."
    ?native "amr.regrid_int"
