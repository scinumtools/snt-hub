# Optional ELECTRONS controls observed in the pinned PWscf regression set.
$schema qe_electrons_diago_thr_init
  diago_thr_init float AU_0.5*E_h
    !condition ({.} > 0 AU_0.5*E_h)
    ?descr "Initial diagonalization energy threshold, in QE's native Ry convention."
    !tags ["qe:param"]
    ?native "diago_thr_init"

$schema qe_electrons_diagonalization
  diagonalization str
    ?descr "Diagonalization algorithm."
    !tags ["qe:param"]
    ?native "diagonalization"

$schema qe_electrons_conv_thr
  conv_thr float AU_0.5*E_h
    !condition ({.} > 0 AU_0.5*E_h)
    ?descr "Self-consistency convergence energy threshold, in QE's native Ry convention."
    !tags ["qe:param"]
    ?native "conv_thr"

$schema qe_electrons_diago_david_ndim
  diago_david_ndim int
    !condition ({.} > 0)
    ?descr "Davidson subspace dimension."
    !tags ["qe:param"]
    ?native "diago_david_ndim"

$schema qe_electrons_mixing_mode
  mixing_mode str
    ?descr "Charge mixing method."
    !tags ["qe:param"]
    ?native "mixing_mode"

$schema qe_electrons_mixing_beta
  mixing_beta float
    !condition ({.} > 0)
    ?descr "Charge mixing factor."
    !tags ["qe:param"]
    ?native "mixing_beta"

$schema qe_electrons_mixing_ndim
  mixing_ndim int
    !condition ({.} > 0)
    ?descr "Number of iterations retained for charge mixing."
    !tags ["qe:param"]
    ?native "mixing_ndim"
