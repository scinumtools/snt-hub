# Imported from pinned QE test-suite/pw_scf/scf-occ.in.

control : qe_control, qe_control_tstress
  calculation = "scf"
  tstress = true
  pseudo_dir = "./pseudo/"
  outdir = "./tmp/"

system : qe_system, qe_system_celldm_1, qe_system_nbnd, qe_system_occupations
  ibrav = 2
  celldm_1 = 10.2
  nat = 2
  ntyp = 1
  ecutwfc = 12.0
  nbnd = 8
  occupations = "from_input"

structure : qe_structure
  position_units = "alat"
  species[]
    symbol = "Si"
    mass = 28.086
    pseudo_file = "Si.pz-vbc.UPF"
  atoms[]
    species = "Si"
    x = 0.0
    y = 0.0
    z = 0.0
  atoms[]
    species = "Si"
    x = 0.25
    y = 0.25
    z = 0.25

sampling : qe_sampling, qe_sampling_explicit
  mode = "tpiba"
  points[]
    x = 0.25
    y = 0.25
    z = 0.25
    weight = 1.0
  points[]
    x = 0.25
    y = 0.25
    z = 0.75
    weight = 3.0

occupations : qe_occupation_values
  bands = [2.0, 2.0, 2.0, 2.0, 0.0, 0.0, 0.0, 0.0]
