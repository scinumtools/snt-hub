# Imported from pinned QE test-suite/pw_scf/scf-2.in.

control : qe_control
  calculation = "nscf"
  pseudo_dir = "./pseudo/"
  outdir = "./tmp/"

system : qe_system, qe_system_celldm_1, qe_system_nbnd
  ibrav = 2
  celldm_1 = 10.2
  nat = 2
  ntyp = 1
  ecutwfc = 12.0
  nbnd = 8

structure : qe_structure
  position_units = "alat"
  species[]
    symbol = "Si"
    mass = 28.086
    pseudo_file = "Si.pz-vbc.UPF"
  atoms[]
    species = "Si"
    x = 0.0
    y = 0.0
    z = 0.0
  atoms[]
    species = "Si"
    x = 0.25
    y = 0.25
    z = 0.25

