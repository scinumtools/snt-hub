# Imported from pinned QE test-suite/pw_scf/scf-rmm-paro-k.in.

control : qe_control, qe_control_tprnfor
  calculation = "scf"
  tprnfor = true
  pseudo_dir = "./pseudo/"
  outdir = "./tmp/"

system : qe_system, qe_system_celldm_1, qe_system_input_dft
  ibrav = 2
  celldm_1 = 10.2
  nat = 2
  ntyp = 1
  ecutwfc = 60.0
  input_dft = "pbe"

electrons : qe_electrons_conv_thr, qe_electrons_diagonalization
  diagonalization = "rmm-paro"
  conv_thr = 1e-12

structure : qe_structure
  position_units = "alat"
  species[]
    symbol = "Si"
    mass = 28.086
    pseudo_file = "Si.pbe-rrkj.UPF"
  atoms[]
    species = "Si"
    x = 0.0
    y = 0.0
    z = 0.0
  atoms[]
    species = "Si"
    x = 0.25
    y = 0.25
    z = 0.25

sampling : qe_sampling, qe_sampling_explicit
  mode = "tpiba"
  points[]
    x = 0.25
    y = 0.25
    z = 0.25
    weight = 1.0
  points[]
    x = 0.25
    y = 0.25
    z = 0.75
    weight = 3.0
