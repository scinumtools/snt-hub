# Imported from pinned QE test-suite/pw_scf/scf-gth.in.

control : qe_control, qe_control_tprnfor, qe_control_tstress
  calculation = "scf"
  tprnfor = true
  tstress = true
  pseudo_dir = "./pseudo/"
  outdir = "./tmp/"

system : qe_system, qe_system_vdw_corr
  ibrav = 0
  nat = 28
  ntyp = 3
  ecutwfc = 40.0
  vdw_corr = "dft-d2"

electrons : qe_electrons_conv_thr
  conv_thr = 1e-08

